# Server Configuration
PORT=3000
CORS_ORIGIN=*

# Environment
MAPICS_ENV=XX
QQ=*LIBL

# Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h
ENABLE_BASIC_AUTH=true
ENABLE_BEARER_AUTH=true

# Tables (for SQLite testing)
USERS_TABLE=USERS
ROLES_TABLE=ROLES
PERMISSIONS_TABLE=PERMISSIONS

# IBM i Configuration (for reference)
IBMI_SYSTEM=localhost
IBMI_LIBRARY=*LIBL
IBMI_NAMING=*Sys

# API Configuration
API_BASE_PATH=/
API_VERSION=1.0.0
API_TITLE=IBM i Dynamic REST API
API_DESCRIPTION=Dynamic REST API server for IBM i systems

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Database Pool
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=600

OBBC_DRIVER='IBM i Access ODBC Driver'

LIBL=QGPL QTEMP