{
  "name": "dynamic-rest-api",
  "version": "1.0.0",
  "description": "Dynamic REST API server for IBM i with config-driven routes and ODBC support",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && SKIP_DB_INIT=true node dist/server.js",
    "start": "node dist/server.js",
    "start:dev": "npm run build && SKIP_DB_INIT=true node dist/server.js",
    "clean": "rm -rf dist",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@scalar/core": "^0.3.16",
    "@scalar/express-api-reference": "^0.8.17",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "odbc": "^2.4.9",
    "passport": "^0.7.0",
    "passport-http": "^0.3.0",
    "passport-http-bearer": "^1.0.1",
    "type-fest": "^4.41.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.11.0",
    "@types/passport": "^1.0.16",
    "@types/passport-http": "^0.3.11",
    "@types/passport-http-bearer": "^1.0.41",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.10.3 < 23.0.0"
  },
  "keywords": [
    "rest-api",
    "dynamic-routes",
    "ibm-i",
    "as400",
    "odbc",
    "sql",
    "config-driven",
    "enterprise",
    "database-connectivity"
  ],
  "author": "IBM i REST API Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/dynamic-rest-api.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/dynamic-rest-api/issues"
  },
  "homepage": "https://github.com/your-org/dynamic-rest-api#readme"
}
