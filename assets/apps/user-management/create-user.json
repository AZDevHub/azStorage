{
  "path": "/usermanagement/api/users",
  "method": "POST",
  "description": "Create a new user in the RBAC system",
  "authentication": {
    "required": true,
    "roles": ["admin"]
  },
  "parameters": {
    "body": {
      "username": {
        "type": "string",
        "description": "Unique username for the user",
        "required": true,
        "minLength": 3,
        "maxLength": 50,
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "email": {
        "type": "string",
        "description": "User email address",
        "required": true,
        "format": "email"
      },
      "password": {
        "type": "string",
        "description": "User password (will be hashed)",
        "required": true,
        "minLength": 8
      },
      "firstName": {
        "type": "string",
        "description": "User's first name",
        "required": true,
        "maxLength": 100
      },
      "lastName": {
        "type": "string",
        "description": "User's last name",
        "required": true,
        "maxLength": 100
      },
      "ibmiProfile": {
        "type": "string",
        "description": "Associated IBM i user profile",
        "required": false,
        "maxLength": 10
      },
      "status": {
        "type": "string",
        "description": "User account status",
        "required": false,
        "enum": ["active", "inactive", "suspended"],
        "default": "active"
      }
    }
  },
  "sql": "INSERT INTO {{usersTable}} (user_id, username, email, password_hash, first_name, last_name, ibmi_profile, status, created_date, created_by, last_modified_date, last_modified_by) VALUES (NEXT VALUE FOR {{usersSequence}}, {{username}}, {{email}}, {{passwordHash}}, {{firstName}}, {{lastName}}, {{ibmiProfile}}, {{status}}, CURRENT_TIMESTAMP, {{currentUser}}, CURRENT_TIMESTAMP, {{currentUser}})",
  "parameterMappings": {
    "usersTable": "config.tables.users",
    "usersSequence": "config.sequences.users",
    "username": "body.username",
    "email": "body.email",
    "passwordHash": "body.password",
    "firstName": "body.firstName",
    "lastName": "body.lastName",
    "ibmiProfile": "body.ibmiProfile",
    "status": "body.status",
    "currentUser": "auth.username"
  },
  "response": {
    "type": "object",
    "contentType": "application/json",
    "statusCode": 201
  },
  "postProcessing": {
    "hashPassword": true,
    "returnCreatedId": true
  }
}