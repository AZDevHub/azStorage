{
  "path": "/usermanagement/api/users/:userId",
  "method": "DELETE",
  "description": "Delete a user (soft delete)",
  "authentication": {
    "required": true,
    "roles": ["admin"]
  },
  "parameters": {
    "path": {
      "userId": {
        "type": "number",
        "description": "User ID to delete",
        "required": true
      }
    },
    "query": {
      "hardDelete": {
        "type": "boolean",
        "description": "Perform hard delete instead of soft delete",
        "required": false,
        "default": false
      }
    }
  },
  "sql": "{{deleteQuery}}",
  "parameterMappings": {
    "deleteQuery": "computed.deleteQuery",
    "usersTable": "config.tables.users",
    "userId": "path.userId",
    "currentUser": "auth.username"
  },
  "computed": {
    "deleteQuery": {
      "condition": "query.hardDelete",
      "true": "DELETE FROM {{usersTable}} WHERE user_id = {{userId}}",
      "false": "UPDATE {{usersTable}} SET status = 'deleted', deleted_date = CURRENT_TIMESTAMP, deleted_by = {{currentUser}}, last_modified_date = CURRENT_TIMESTAMP, last_modified_by = {{currentUser}} WHERE user_id = {{userId}}"
    }
  },
  "response": {
    "type": "object",
    "contentType": "application/json",
    "statusCode": 204
  },
  "postProcessing": {
    "auditLog": true,
    "cascadeDelete": ["userRoles", "userSessions"]
  }
}