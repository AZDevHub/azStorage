{
  "path": "/usermanagement/api/users/:userId",
  "method": "PUT",
  "description": "Update an existing user",
  "authentication": {
    "required": true,
    "roles": ["admin", "user_manager"],
    "selfAccess": "limited"
  },
  "parameters": {
    "path": {
      "userId": {
        "type": "number",
        "description": "User ID to update",
        "required": true
      }
    },
    "body": {
      "email": {
        "type": "string",
        "description": "User email address",
        "required": false,
        "format": "email"
      },
      "firstName": {
        "type": "string",
        "description": "User's first name",
        "required": false,
        "maxLength": 100
      },
      "lastName": {
        "type": "string",
        "description": "User's last name",
        "required": false,
        "maxLength": 100
      },
      "ibmiProfile": {
        "type": "string",
        "description": "Associated IBM i user profile",
        "required": false,
        "maxLength": 10
      },
      "status": {
        "type": "string",
        "description": "User account status",
        "required": false,
        "enum": ["active", "inactive", "suspended"],
        "adminOnly": true
      },
      "password": {
        "type": "string",
        "description": "New password (will be hashed)",
        "required": false,
        "minLength": 8
      }
    }
  },
  "sql": "UPDATE {{usersTable}} SET email = COALESCE({{email}}, email), first_name = COALESCE({{firstName}}, first_name), last_name = COALESCE({{lastName}}, last_name), ibmi_profile = COALESCE({{ibmiProfile}}, ibmi_profile), status = COALESCE({{status}}, status), password_hash = COALESCE({{passwordHash}}, password_hash), password_changed_date = CASE WHEN {{passwordHash}} IS NOT NULL THEN CURRENT_TIMESTAMP ELSE password_changed_date END, last_modified_date = CURRENT_TIMESTAMP, last_modified_by = {{currentUser}} WHERE user_id = {{userId}}",
  "parameterMappings": {
    "usersTable": "config.tables.users",
    "userId": "path.userId",
    "email": "body.email",
    "firstName": "body.firstName",
    "lastName": "body.lastName",
    "ibmiProfile": "body.ibmiProfile",
    "status": "body.status",
    "passwordHash": "body.password",
    "currentUser": "auth.username"
  },
  "response": {
    "type": "object",
    "contentType": "application/json"
  },
  "postProcessing": {
    "hashPassword": true,
    "validateSelfUpdate": true,
    "auditLog": true
  }
}