{
  "path": "/usermanagement/api/permissions",
  "method": "POST",
  "description": "Create a new permission",
  "authentication": {
    "required": true,
    "roles": ["admin"]
  },
  "parameters": {
    "body": {
      "permissionName": {
        "type": "string",
        "description": "Unique permission name (e.g., 'users.create', 'items.read')",
        "required": true,
        "minLength": 3,
        "maxLength": 100,
        "pattern": "^[a-zA-Z0-9._-]+$"
      },
      "resource": {
        "type": "string",
        "description": "Resource this permission applies to",
        "required": true,
        "maxLength": 50
      },
      "action": {
        "type": "string",
        "description": "Action allowed by this permission",
        "required": true,
        "enum": ["create", "read", "update", "delete", "execute", "approve", "manage"]
      },
      "description": {
        "type": "string",
        "description": "Permission description",
        "required": true,
        "maxLength": 255
      },
      "isSystem": {
        "type": "boolean",
        "description": "Whether this is a system permission",
        "required": false,
        "default": false
      }
    }
  },
  "sql": "INSERT INTO {{permissionsTable}} (permission_id, permission_name, resource, action, description, is_system, created_date, created_by) VALUES (NEXT VALUE FOR {{permissionsSequence}}, {{permissionName}}, {{resource}}, {{action}}, {{description}}, {{isSystem}}, CURRENT_TIMESTAMP, {{currentUser}})",
  "parameterMappings": {
    "permissionsTable": "config.tables.permissions",
    "permissionsSequence": "config.sequences.permissions",
    "permissionName": "body.permissionName",
    "resource": "body.resource",
    "action": "body.action",
    "description": "body.description",
    "isSystem": "body.isSystem",
    "currentUser": "auth.username"
  },
  "response": {
    "type": "object",
    "contentType": "application/json",
    "statusCode": 201
  },
  "validation": {
    "checkDuplicates": true
  },
  "postProcessing": {
    "returnCreatedId": true
  }
}