{
  "path": "/auth/login",
  "method": "POST",
  "description": "User authentication",
  "parameters": {
    "body": {
      "username": {
        "type": "string", 
        "description": "Username",
        "required": true
      },
      "password": {
        "type": "string",
        "description": "Password", 
        "required": true
      }
    }
  },
  "sql": "SELECT user_id, username, email, '{{username}}' as login_username FROM {{userTable}} WHERE username = '{{username}}' AND password_hash = HASH('{{password}}')",
  "parameterMappings": {
    "username": "body.username",
    "password": "body.password", 
    "userTable": "config.tables.users"
  },
  "response": {
    "type": "object",
    "contentType": "application/json"
  }
}